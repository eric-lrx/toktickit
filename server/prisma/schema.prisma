// Prisma schema — datasource and generator are pre-wired.
// Your DATABASE_URL lives in server/.env (copy it from .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  tickets   Ticket[]
}

enum Role {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}

// Lab 3 — renamed in place from RequesterUser (Lab 2's temporary "fake login",
// BR-03). Real authentication: bcrypt passwordHash, one role, mustChangePassword
// gate (specification.md §7/§11, BR-01/BR-02/BR-06).
model User {
  id                 Int      @id @default(autoincrement())
  name               String
  email              String   @unique
  passwordHash       String
  role               Role
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  tickets            Ticket[]
  ownedTickets       Ticket[] @relation("TicketOwner")
  publicComments     PublicComment[]
  internalNotes      InternalNote[]
  actionsPerformed   ActionTaken[] @relation("ActionPerformer")
  actionsAssigned    ActionTaken[] @relation("ActionAssignee")
  statusChanges      TicketStatusChange[]
  idempotencyKeys    IdempotencyKey[]
}

model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  tickets   Ticket[]
}

enum RequestedPriority {
  LOW
  MEDIUM
  HIGH
}

// Lab 3, Issue 35 — grown from NEW alone to the full transition-table
// vocabulary (BRIEFING_AGENT_LAB03.md). ALTER TYPE ... ADD VALUE, never a
// recreation, so every existing NEW row is untouched.
enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

model Ticket {
  id                Int               @id @default(autoincrement())
  ticketNumber      String            @unique
  requesterId       Int
  requester         User              @relation(fields: [requesterId], references: [id])
  categoryId        Int
  category          Category          @relation(fields: [categoryId], references: [id])
  relatedSystemId   Int
  relatedSystem     RelatedSystem     @relation(fields: [relatedSystemId], references: [id])
  summary           String
  description       String
  requestedPriority RequestedPriority
  status            TicketStatus      @default(NEW)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  attachments       Attachment[]

  // Lab 3, Issue 35 (specification.md §7 migration path, steps 5-7) — added
  // together in one migration since they're all part of the same "grow the
  // Ticket for the IT Staff workflow" step, even though only itPriority is
  // consumed by this Issue's queue; Issues 36/37 consume the rest without
  // any further schema churn.
  //
  // itPriority reuses the RequestedPriority enum rather than declaring a
  // duplicate ITPriority type with the identical LOW|MEDIUM|HIGH values —
  // one Requester-set value, one IT-Staff-set value, same vocabulary.
  itPriority                    RequestedPriority
  ticketOwnerId                 Int?
  ticketOwner                   User?     @relation("TicketOwner", fields: [ticketOwnerId], references: [id])
  resolutionSummary             String?
  requesterResolutionIndicatedAt DateTime?

  publicComments PublicComment[]
  internalNotes  InternalNote[]

  // Lab 4 (specification.md §7) — optimistic concurrency counter and the
  // moment the Ticket last became RESOLVED (BR-16).
  version       Int       @default(1)
  resolvedAt    DateTime?
  actionsTaken  ActionTaken[]
  statusChanges TicketStatusChange[]

  @@index([requesterId])
  @@index([createdAt])
  @@index([ticketOwnerId])
  @@index([status])
}

// Issue 37 — two separate tables, not one table with an isInternal flag: a
// forgotten `WHERE isInternal = false` filter would leak Internal Notes to
// a Requester through the Public Comments endpoint; with separate tables,
// the Requester-facing endpoint structurally has no column to leak from
// (specification.md §7). Both are append-only (BR-25) — no updatedAt, no
// edit/delete route exists anywhere in app.ts.
model PublicComment {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())

  @@index([ticketId])
}

model InternalNote {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())

  @@index([ticketId])
}

enum ActionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Lab 4, Issue 23 — the handout's seven fields plus assigneeId and status
// (specification.md §11: Part 6 and the resolution gate need both) and a
// version counter for optimistic concurrency (BR-19/BR-20).
model ActionTaken {
  id               Int          @id @default(autoincrement())
  ticketId         Int
  ticket           Ticket       @relation(fields: [ticketId], references: [id])
  performedById    Int
  performedBy      User         @relation("ActionPerformer", fields: [performedById], references: [id])
  assigneeId       Int?
  assignee         User?        @relation("ActionAssignee", fields: [assigneeId], references: [id])
  actionAt         DateTime     @default(now())
  description      String
  result           String?
  status           ActionStatus @default(PLANNED)
  followUpRequired Boolean      @default(false)
  followUpNote     String?
  attachmentNotes  String?
  version          Int          @default(1)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([ticketId])
  @@index([assigneeId, status])
}

// Append-only (BR-18): no update or delete route exists for this table.
model TicketStatusChange {
  id          Int          @id @default(autoincrement())
  ticketId    Int
  ticket      Ticket       @relation(fields: [ticketId], references: [id])
  fromStatus  TicketStatus
  toStatus    TicketStatus
  changedById Int
  changedBy   User         @relation(fields: [changedById], references: [id])
  changedAt   DateTime     @default(now())

  @@index([ticketId])
}

// BR-28 — one row per (user, Idempotency-Key): a repeated create returns the
// stored response instead of creating a duplicate.
model IdempotencyKey {
  id             Int      @id @default(autoincrement())
  key            String
  userId         Int
  user           User     @relation(fields: [userId], references: [id])
  route          String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())

  @@unique([userId, key])
}

// Issue 11 — Attachment lifecycle. storedName is a UUID + validated extension,
// never the client-supplied filename (path traversal, BR-17); originalName is
// display-only. Soft removal via removedAt/removalReason (BR-19).
model Attachment {
  id            Int       @id @default(autoincrement())
  ticketId      Int
  ticket        Ticket    @relation(fields: [ticketId], references: [id])
  originalName  String
  storedName    String
  mimeType      String
  sizeBytes     Int
  uploadedAt    DateTime  @default(now())
  removedAt     DateTime?
  removalReason String?

  @@index([ticketId])
}
